{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions required by PDF Workspace",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "fs:allow-read-file",
    "fs:allow-copy-file",
    "fs:allow-mkdir",
    "fs:scope-applocaldata-recursive",
    "updater:default",
    "dialog:allow-save",
    "fs:allow-write-file",
    "process:allow-restart"
  ]
}
